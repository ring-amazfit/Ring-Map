<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="112dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/settingsToolbar" android:layout_width="match_parent" android:layout_height="64dp" android:paddingStart="12dp" android:paddingEnd="12dp" app:title="设置" app:subtitle="权限与应用信息" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="系统权限" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/md3_surface_container" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="@color/md3_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/rowNotificationAccess" android:layout_width="match_parent" android:layout_height="72dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="通知使用权" android:src="@drawable/ic_notifications_24"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="通知使用权" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/><TextView android:id="@+id/tvNotificationAccessValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检查中" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant"/></LinearLayout><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="打开" android:src="@drawable/ic_open_external_24"/></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="@color/md3_outline_variant"/>
                    <LinearLayout android:id="@+id/rowConnectionProtection" android:layout_width="match_parent" android:layout_height="72dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="增强连接" android:src="@drawable/ic_battery_24"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="增强连接" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/><TextView android:id="@+id/tvConnectionProtectionValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检查中" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant"/></LinearLayout><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="打开" android:src="@drawable/ic_chevron_right_24"/></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="@color/md3_outline_variant"/>
                    <LinearLayout android:id="@+id/rowBackgroundAccess" android:layout_width="match_parent" android:layout_height="72dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="后台运行" android:src="@drawable/ic_battery_24"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="后台运行教程" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="自启动 · 后台运行 · 不从最近任务清理" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant"/></LinearLayout><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="打开" android:src="@drawable/ic_open_external_24"/></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="数据边界" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/md3_surface_container" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="@color/md3_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/rowSources" android:layout_width="match_parent" android:layout_height="72dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="支持来源" android:src="@drawable/ic_map_source_24"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="支持的导航来源" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="高德地图 · 百度地图" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant"/></LinearLayout><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="查看" android:src="@drawable/ic_chevron_right_24"/></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="@color/md3_outline_variant"/>
                    <LinearLayout android:id="@+id/rowPrivacy" android:layout_width="match_parent" android:layout_height="72dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="隐私" android:src="@drawable/ic_privacy_24"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="隐私与联网" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="不定位 · 不调用地图 API · 不上传" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant"/></LinearLayout><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="查看" android:src="@drawable/ic_chevron_right_24"/></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="应用" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/rowAbout" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/md3_surface_container" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="@color/md3_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="关于" android:src="@drawable/ic_info_24"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="关于 RingMap" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="版本、开源仓库与第三方声明" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant"/></LinearLayout><ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="查看" android:src="@drawable/ic_chevron_right_24"/></LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvSettingsVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Android Alpha-2 · 协议 v2" android:textAppearance="@style/TextAppearance.Material3.LabelSmall" android:textColor="@color/md3_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

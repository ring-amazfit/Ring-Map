<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingBottom="96dp">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/diagnosticsToolbar" android:layout_width="match_parent" android:layout_height="64dp" android:paddingStart="12dp" android:paddingEnd="12dp" app:menu="@menu/menu_diagnostics" app:title="连接诊断" app:subtitle="最近 100 条脱敏事件" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" app:cardBackgroundColor="@color/md3_surface_container" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="@color/md3_outline_variant" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App-Side 客户端" android:textColor="@color/md3_on_surface_variant"/><TextView android:id="@+id/tvDiagnosticClients" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="最新 ACK" android:textColor="@color/md3_on_surface_variant"/><TextView android:id="@+id/tvDiagnosticAck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="尚未收到" android:textStyle="bold"/></LinearLayout>
            <TextView android:id="@+id/tvDiagnosticLatest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:maxLines="2" android:text="暂无事件" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="8dp" android:text="事件流" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerDiagnostics" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp" />
    <TextView android:id="@+id/tvDiagnosticsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="暂无诊断事件" android:textColor="@color/md3_on_surface_variant" android:visibility="gone" />
</LinearLayout>

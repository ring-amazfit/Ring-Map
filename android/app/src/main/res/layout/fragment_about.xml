<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/aboutToolbar" android:layout_width="match_parent" android:layout_height="64dp" android:paddingStart="4dp" android:paddingEnd="12dp" app:navigationIcon="@drawable/ic_arrow_back_24" app:title="关于" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="36dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/bg_corridor_frame" android:clipToOutline="true">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="RingMap 角色背景" android:scaleType="centerCrop" android:src="@drawable/ringmap_character_status" />
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_corridor_scrim" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RINGMAP" android:textColor="@color/corridor_text" android:textSize="32sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Android 3.0.0 · ZeppOS 3.0.0 · 协议 v2" android:textColor="@color/corridor_text_secondary" android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="系统导航通知到腕上下一步。" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="@color/md3_on_surface" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="RingMap 只在设备本地读取高德或百度的系统导航通知，通过 Zepp App-Side 同步到手表。" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md3_on_surface_variant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenGithub" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="打开 GitHub 仓库" app:icon="@drawable/ic_open_external_24" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="第三方资源" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="部分导航箭头来自 Icons8，保留原始颜色；补充动作与夜骑路廊背景由 RingMap 原创。" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md3_on_surface_variant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenIcons8" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="start" android:text="查看 Icons8" app:icon="@drawable/ic_open_external_24" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="App ID 1121554\n包名 com.ringmap.nav\n不含地图 SDK、定位权限、API Key 或遥测。" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="112dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/navigationToolbar" android:layout_width="match_parent" android:layout_height="64dp" android:paddingStart="12dp" android:paddingEnd="12dp" app:title="实时导航" app:subtitle="系统通知镜像" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="390dp" android:background="@drawable/bg_corridor_frame" android:clipToOutline="true">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="RingMap 角色背景" android:scaleType="centerCrop" android:src="@drawable/ringmap_character_navigation" />
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_corridor_scrim" />
                <LinearLayout android:id="@+id/groupNavActive" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp" android:paddingBottom="16dp" android:visibility="gone">
                    <TextView android:id="@+id/tvNavSource" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status_badge" android:text="高德地图 · 实时" android:textColor="@color/corridor_text" android:textSize="12sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/ivNavAction" android:layout_width="152dp" android:layout_height="152dp" android:contentDescription="当前导航动作" android:scaleType="centerInside" android:src="@drawable/nav_straight" />
                    <TextView android:id="@+id/tvNavDistance" android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center" android:maxLines="1" android:text="—" android:textColor="@color/corridor_text" android:textSize="52sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvNavInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="" android:textColor="@color/corridor_text" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvNavRoad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="" android:textColor="@color/corridor_text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/tvNavDelivery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:maxLines="1" android:text="等待手表确认" android:textColor="@color/corridor_accent" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/groupNavEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="28dp">
                    <TextView android:id="@+id/tvNavEmptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="等待系统导航" android:textColor="@color/corridor_text" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvNavEmptyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:maxLines="2" android:text="手机链路准备后，当前步骤会自动出现" android:textColor="@color/corridor_text_secondary" android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/ivTimingIcon" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="传输时序" android:src="@drawable/ringmap_mark_round" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="传输时序" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/md3_on_surface" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="通知到手表控件更新" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/md3_surface_container" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeColor="@color/md3_outline_variant" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Android 解析" android:textColor="@color/md3_on_surface_variant"/><TextView android:id="@+id/tvMetricParse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/md3_on_surface" android:textStyle="bold"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App-Side 收到" android:textColor="@color/md3_on_surface_variant"/><TextView android:id="@+id/tvMetricBridge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/md3_on_surface" android:textStyle="bold"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="手表控件更新" android:textColor="@color/md3_on_surface_variant"/><TextView android:id="@+id/tvMetricWatch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/md3_on_surface" android:textStyle="bold"/></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="发出至控件确认" android:textColor="@color/md3_on_surface_variant"/><TextView android:id="@+id/tvMetricRoundTrip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/md3_on_surface" android:textStyle="bold"/></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvNavSession" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:ellipsize="middle" android:maxLines="1" android:text="会话：—" android:textAppearance="@style/TextAppearance.Material3.LabelSmall" android:textColor="@color/md3_on_surface_variant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

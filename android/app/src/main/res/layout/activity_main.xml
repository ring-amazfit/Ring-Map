<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/md3_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md3_surface"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:title="环间导航"
            app:titleTextColor="@color/md3_on_surface"
            app:subtitle="手机通知 · 手表同步"
            app:subtitleTextColor="@color/md3_on_surface_variant" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeroStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md3_primary_container"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvHeroEyebrow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="同步状态"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/md3_on_primary_container" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRefresh"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="刷新"
                            android:textColor="@color/md3_primary" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvHeroState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="正在检查同步状态"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textColor="@color/md3_on_primary_container"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvHeroDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="正在检查通知监听与手表连接"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/md3_on_primary_container" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeroAction"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="前往授权"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="同步链路"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/md3_on_surface" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPipeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/md3_surface_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md3_outline_variant"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="听" android:textStyle="bold" android:textColor="@color/md3_on_primary" android:background="@drawable/bg_status_icon" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="通知监听" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/md3_on_surface" />
                            <TextView android:id="@+id/tvListenerState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检查中" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="12dp" android:layout_marginStart="20dp" android:background="@color/md3_outline_variant" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="听" android:textStyle="bold" android:textColor="@color/md3_on_primary" android:background="@drawable/bg_status_icon" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="通知监听" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/md3_on_surface" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检查中" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="12dp" android:layout_marginStart="20dp" android:background="@color/md3_outline_variant" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="服" android:textStyle="bold" android:textColor="@color/md3_on_primary" android:background="@drawable/bg_status_icon" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="同步服务" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/md3_on_surface" />
                            <TextView android:id="@+id/tvServiceState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检查中" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="12dp" android:layout_marginStart="20dp" android:background="@color/md3_outline_variant" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="表" android:textStyle="bold" android:textColor="@color/md3_on_primary" android:background="@drawable/bg_status_icon" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="手表端应用" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/md3_on_surface" />
                            <TextView android:id="@+id/tvWatchState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="未检测到连接" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNavPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/md3_surface_container_high"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="导航预览" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/md3_on_surface" />
                        <TextView android:id="@+id/tvNavLive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="等待中" android:textAppearance="@style/TextAppearance.Material3.LabelMedium" android:textColor="@color/ringmap_warning" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/groupNavEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="28dp" android:paddingBottom="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌁" android:textSize="52sp" android:textColor="@color/md3_primary" />
                        <TextView android:id="@+id/tvNavEmptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="尚未收到导航指令" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/md3_on_surface" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="在手机导航应用中开始导航后，转向和距离会自动同步到手表。" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md3_on_surface_variant" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/groupNavActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:paddingTop="16dp" android:paddingBottom="12dp">
                        <TextView android:id="@+id/tvNavArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑" android:textSize="76sp" android:textColor="@color/md3_primary" />
                        <TextView android:id="@+id/tvNavDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textAppearance="@style/TextAppearance.Material3.DisplaySmall" android:textStyle="bold" android:textColor="@color/md3_on_surface" />
                        <TextView android:id="@+id/tvNavInstruction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/md3_on_surface" />
                        <TextView android:id="@+id/tvNavSyncedAt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="" android:textAppearance="@style/TextAppearance.Material3.LabelSmall" android:textColor="@color/md3_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/md3_secondary_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:id="@+id/tvNextStepTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一步" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/md3_on_secondary_container" />
                    <TextView android:id="@+id/tvNextStepDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md3_on_secondary_container" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnNextStep" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/md3_error_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="需要授权通知使用权" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/md3_on_error_container" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="用于读取系统导航通知，不能读取其他应用内容。" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md3_on_error_container" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantPermission" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="前往授权" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/md3_surface_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/md3_outline_variant"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="诊断与帮助" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="@color/md3_on_surface" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggleDiagnostics" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:text="展开" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvDebug" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="暂无监听事件" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md3_on_surface_variant" android:fontFamily="monospace" android:maxLines="6" android:ellipsize="end" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <!-- 已移除外部地图 Key 设置：RingMap 不使用任何外部地图 API。 -->
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
